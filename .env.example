# =====================================================
# Ember Sentinel Server — 환경 변수 예시
# 복사: cp .env.example .env
# =====================================================

# Spring 프로필 (local | dev | prod)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_DB=ember_sentinel
POSTGRES_USER=ember
POSTGRES_PASSWORD=ember_local_password

# MinIO (S3 호환)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
