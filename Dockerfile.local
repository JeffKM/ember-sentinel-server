# ============================
# 로컬 개발용 멀티 스테이지 빌드
# Firebase 키 없이도 빌드 가능
# ============================

# --- Stage 1: Gradle 빌드 ---
FROM eclipse-temurin:17-jdk AS builder

WORKDIR /build

# Gradle Wrapper 및 설정 파일 복사 (캐싱 최적화)
COPY gradlew settings.gradle build.gradle ./
COPY gradle/ gradle/
RUN chmod +x gradlew

# 의존성 다운로드 (소스 변경 시 캐시 재사용)
RUN ./gradlew dependencies --no-daemon || true

# 소스 코드 복사 및 빌드
COPY src/ src/

# secrets 서브모듈이 없어도 빌드 가능하도록 디렉토리 생성
RUN mkdir -p src/main/resources/secrets

# 테스트 스킵하고 빌드 (로컬 환경은 application-local.yml 사용)
RUN ./gradlew bootJar -x test --no-daemon

# --- Stage 2: 런타임 ---
FROM eclipse-temurin:17-jre

WORKDIR /app

# 빌드된 JAR 복사
COPY --from=builder /build/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
